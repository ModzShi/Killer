Options -Indexes

<FilesMatch "(?i)\.(?:sql|sqlite|db|bak|backup|old|log|env|ini|yml|yaml|toml|md)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.well-known/acme-challenge/ - [L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(?:app|config|docs|payments|tests|tools)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:conectarbanco|bxpay|knucklespay|teste_bxpay)\.php$ - [F,L,NC]
  RewriteRule \.(?:bak|backup|old)\.php$ - [F,L,NC]
  RewriteRule ^(?:play|enddemo|demo|presell/game|influencer/jogar)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:influencer/(?:win|loss|processar_subtracao)|saque/saque|saque/arquivos/saque_realizado|deposito/(?:pix|consultarpagamento|aprovar_teste|processarsaldo)|webhook/(?:pix|index)|game/(?:update|loseGame|index))\.php$ - [F,L,NC]
  RewriteRule ^adm/gateway/bd\.php$ - [F,L,NC]
  RewriteRule ^saque-afiliado/bd\.php$ - [F,L,NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404_not_found.php [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Defina o pacote “ea-php81” como a linguagem padrão de programação “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
